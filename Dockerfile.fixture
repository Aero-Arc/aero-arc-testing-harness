FROM golang:1.26.2 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -o /out/fault-fixture ./cmd/fault-fixture

FROM gcr.io/distroless/static-debian12
COPY --from=build /out/fault-fixture /fault-fixture
EXPOSE 8081
ENTRYPOINT ["/fault-fixture"]
